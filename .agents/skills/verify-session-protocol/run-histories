with tempfile.TemporaryDirectory(prefix='database-session-histories-') as scratch:
 root=pathlib.Path(scratch)
 for model,controls in json.loads((skill/'history-model-index.json').read_text()).items():
  for suffix,fault,rule in [('',None,None)]+controls:
   config=model+(suffix+'Broken' if suffix else '')
   r=subprocess.run(['java','-XX:ActiveProcessorCount=2','-cp',str(jar),'tlc2.TLC','-workers','1','-metadir',str(root/config),'-config',str(skill/(config+'.cfg')),str(skill/(model+'.tla'))],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
   print(config+':\n'+r.stdout,flush=True)
   if rule is None and r.returncode:raise SystemExit('Current history model failed: '+model)
   if rule and (r.returncode!=12 or 'Invariant '+rule+' is violated' not in r.stdout):raise SystemExit('Broken history model missed its rule: '+config)
 for index,variant in enumerate([None]+mutations+[None]):
  name=('current' if index==0 else 'restored-current') if variant is None else variant[0]
  overlay={'Replace':{str(repo/'internal/mysql/zz_formal_history_test.go'):str(skill/'history_test.go.txt')}}
  pattern='^TestFormalHistory'
  if variant:
   _,filename,old,new,test,message=variant;source=repo/'internal/mysql'/filename;original=source.read_text()
   if original.count(old)!=1:raise SystemExit('Source changed; inspect '+name)
   changed=root/(name+'.go');changed.write_text(original.replace(old,new));overlay['Replace'][str(source)]=str(changed);pattern+=''+test+'$'
  path=root/(name+'.json');path.write_text(json.dumps(overlay))
  r=subprocess.run(['go','test','-count=1','-timeout','20s','-overlay',str(path),'./internal/mysql','-run',pattern],cwd=repo,env=env,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
  print(name+':\n'+r.stdout,flush=True)
  if variant is None and r.returncode:raise SystemExit('Current session history probe failed')
  if variant and (r.returncode==0 or message not in r.stdout):raise SystemExit('Source fault missed its assertion: '+name)
print('Seven session history models, fifteen controls, current probes, and sixteen source faults passed.')
