mutations=[
 ('database-selection','server.go','s.database = name','s.database = s.database','SetPrefix','selected database did not persist across SET'),
 ('rsa-request','authentication.go','if len(response) != 1 || response[0] != 0x02 {','if (len(response) != 1 || response[0] != 0x02) && false {','Authentication','plaintext response entered RSA key exchange'),
 ('initial-token','authentication.go','!found || !validPasswordToken(response.token, nonce, passwordHash)','!found || (!validPasswordToken(response.token, nonce, passwordHash) && false)','Authentication','invalid initial token entered full password exchange'),
 ('reset-warnings','server.go','s.clearDiagnostics()','_ = s.diagnostics','Prepared','connection reset retained prepared or session state'),
