#!/usr/bin/env python3
import hashlib,json,os,pathlib,subprocess,tempfile
skill=pathlib.Path(__file__).resolve().parent;repo=skill.parents[2]
jar=pathlib.Path(os.environ.get('TLA2TOOLS',pathlib.Path.home()/'.cache/database-formal/tla2tools-1.7.4.jar'))
if not jar.is_file() or hashlib.sha256(jar.read_bytes()).hexdigest()!='936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88':raise SystemExit('Use the pinned TLC 1.7.4 jar.')
env=dict(os.environ,GOMAXPROCS='2',GOFLAGS='-p=2')
with tempfile.TemporaryDirectory(prefix='database-backup-stream-') as scratch:
 root=pathlib.Path(scratch)
 for module,rule in [('BackupChunks','BufferedAndEmittedMatchInput'),('ArchivePublication','PublicationRequiresSync'),('OnlineCapture','CompleteHasBothClosedFiles')]:
  for suffix in ['','Broken']:
   name=module+suffix
   r=subprocess.run(['java','-XX:ActiveProcessorCount=2','-cp',str(jar),'tlc2.TLC','-workers','1','-metadir',str(root/name),'-config',str(skill/(name+'.cfg')),str(skill/(module+'.tla'))],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
   print(r.stdout,flush=True)
   if not suffix and r.returncode:raise SystemExit('Current model failed: '+module)
   if suffix and (r.returncode!=12 or ('Invariant '+rule+' is violated') not in r.stdout):raise SystemExit('Broken model missed rule: '+module)
 cases=[('chunks','internal/mysql/backup.go','./internal/mysql','chunks_test.go.txt','^TestFormalBackupChunk', [('reset','writer.buffer = writer.buffer[:0]','writer.buffer = writer.buffer','full chunk was emitted twice','^TestFormalBackupChunkReset$')]),('publication','cmd/database/backup_restore.go','./cmd/database','publication_test.go.txt','^TestFormal(ArchivePublication|OnlineBackupWriter)$',[('sync','syncTemporaryArchive(temporary)','formalSkipBackupSync(temporary)','rename before archive sync','^TestFormalArchivePublication$')]),('client','cmd/database/online_backup.go','./cmd/database','publication_test.go.txt','^TestFormalOnlineBackupWriter$',[('reuse','if writer := writers[path]; writer != nil {','if writer := writers[path]; false {','chunk append failed','^TestFormalOnlineBackupWriter$'),('required','return errors.New("backup capture omitted catalog")','return nil','missing catalog accepted','^TestFormalOnlineBackupWriter$')])]
 for label,relative,package,testfile,pattern,mutations in cases:
  source=repo/relative;text=source.read_text()
  for mutation in [None]+mutations:
   name=label+('-current' if mutation is None else '-'+mutation[0]);overlay={'Replace':{str(source.parent/'zz_formal_stream_test.go'):str(skill/testfile)}}
   contents=text
   if mutation:
    _,old,new,message,mutantpattern=mutation
    if contents.count(old)!=1:raise SystemExit('Source changed: inspect '+name)
    contents=contents.replace(old,new)
   if label=='publication':
    old='return file.Sync()'
    if contents.count(old)!=1:raise SystemExit('Sync source changed')
    contents=contents.replace(old,'err := file.Sync(); formalBackupSynced = err == nil; return err')
    old='os.Rename(temporary.Name(), output)'
    if contents.count(old)!=1:raise SystemExit('Rename source changed')
    contents=contents.replace(old,'formalBackupRename(temporary.Name(), output)')
   patched=root/(name+'.go');patched.write_text(contents);overlay['Replace'][str(source)]=str(patched)
   config=root/(name+'.json');config.write_text(json.dumps(overlay))
   r=subprocess.run(['go','test','-timeout','20s','-count=1','-overlay',str(config),package,'-run',pattern if mutation is None else mutantpattern],cwd=repo,env=env,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
   print(name+':\n'+r.stdout,flush=True)
   if mutation is None and r.returncode:raise SystemExit('Current source probe failed: '+label)
   if mutation and (r.returncode==0 or message not in r.stdout):raise SystemExit('Broken source missed assertion: '+name)
 print('Stream and publication checks passed; three broken models and four source mutations were caught.')
