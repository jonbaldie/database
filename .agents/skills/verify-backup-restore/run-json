  if rule and (r.returncode!=12 or 'Invariant '+rule+' is violated' not in r.stdout):raise SystemExit('Broken model missed rule')
 source=repo/'cmd/database/backup_restore.go';original=source.read_text()
 faults=[('depth','if depth >= 128 {','if depth >= 256 {','excess JSON depth accepted'),('end',"return requireBackupJSONDelimiter(decoder, ']')",'return nil','nested JSON value not fully consumed'),('trailing','if _, err := decoder.Token(); !errors.Is(err, io.EOF) {','if _, err := decoder.Token(); false && !errors.Is(err, io.EOF) {','trailing JSON accepted')]
 for fault in [None]+faults+[None]:
  name='current' if fault is None else fault[0]
