if not jar.is_file() or hashlib.sha256(jar.read_bytes()).hexdigest()!='936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88':raise SystemExit('Use pinned TLC 1.7.4')
env=dict(os.environ,GOMAXPROCS='2',GOFLAGS='-p=2')
with tempfile.TemporaryDirectory(prefix='database-json-formal-') as scratch:
 root=pathlib.Path(scratch)
 for suffix,rule in [('',None),('BrokenDepth','DepthBound'),('BrokenEnd','AcceptedComplete'),('BrokenTrailing','AcceptedComplete')]:
  name='JSONNesting'+suffix
  r=subprocess.run(['java','-XX:ActiveProcessorCount=2','-cp',str(jar),'tlc2.TLC','-workers','1','-metadir',str(root/name),'-config',str(skill/(name+'.cfg')),str(skill/'JSONNesting.tla')],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
  print(name+':\n'+r.stdout,flush=True)
