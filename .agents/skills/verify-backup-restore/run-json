  print(name+':\n'+r.stdout,flush=True)
  if fault is None and r.returncode:raise SystemExit('Current source probe failed')
  if fault and (r.returncode==0 or message not in r.stdout):raise SystemExit('Broken source missed assertion '+name)
print('JSON nesting model, three broken configs, three source faults, and restored current passed.')
