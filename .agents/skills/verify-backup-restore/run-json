  if fault:
   _,old,new,message=fault
   if original.count(old)!=1:raise SystemExit('Source anchor changed '+name)
   patched=root/(name+'.go');patched.write_text(original.replace(old,new));overlay['Replace'][str(source)]=str(patched)
