#!/usr/bin/env python3
import hashlib,json,os,pathlib,subprocess,tempfile
skill=pathlib.Path(__file__).resolve().parent;repo=skill.parents[2]
jar=pathlib.Path(os.environ.get('TLA2TOOLS',pathlib.Path.home()/'.cache/database-formal/tla2tools-1.7.4.jar'))
if not jar.is_file() or hashlib.sha256(jar.read_bytes()).hexdigest()!='936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88':raise SystemExit('Use pinned TLC 1.7.4')
env=dict(os.environ,GOMAXPROCS='2',GOFLAGS='-p=2')
cases=[('BackupRestore','Entries','RestoredHasBothEntries'),('BackupRestore','Whole','NewDirectoryInstallIsWhole'),('ArchivePublication','Failure','FailurePreservesOldOutput'),('BackupChunks','Tail','CompletedStreamMatchesInput')]
faults=[
 ('entries','cmd/database/backup_restore.go','backup_test.go.txt','./cmd/database','for _, entry := range entries {\n\t\tif err := os.Rename(filepath.Join(staging, entry.Name()), filepath.Join(directory, entry.Name())); err != nil {','for _, entry := range entries {\n\t\tif entry.Name()=="catalog.json" { _ = os.Remove(filepath.Join(staging,entry.Name())); continue }\n\t\tif err := os.Rename(filepath.Join(staging, entry.Name()), filepath.Join(directory, entry.Name())); err != nil {','^TestFormalBackupRestore$','restored destination missing entry'),
 ('whole','cmd/database/backup_restore.go','backup_test.go.txt','./cmd/database','return os.Rename(staging, directory)','if err:=os.Mkdir(directory,0700);err!=nil{return err}; if err:=os.Rename(filepath.Join(staging,"catalog.json"),filepath.Join(directory,"catalog.json"));err!=nil{return err}; return errors.New("interrupted partial install")','^TestFormalBackupInstallWhole$','new destination install became partial'),
 ('failure','cmd/database/backup_restore.go','backup_test.go.txt','./cmd/database','if err := write(temporary); err != nil {\n\t\treturn failTemporaryArchive(temporary, err)','if err := write(temporary); err != nil {\n\t\t_ = os.Rename(temporary.Name(),output)\n\t\treturn failTemporaryArchive(temporary, err)','^TestFormalBackupRestore$','failed backup replaced output'),
 ('tail','internal/mysql/backup.go','chunks_test.go.txt','./internal/mysql','if len(writer.buffer) == 0 {','if len(writer.buffer) < instanceBackupChunkSize {','^TestFormalBackupChunkBoundaries$','chunk stream differs from input'),
]
with tempfile.TemporaryDirectory(prefix='database-backup-controls-') as scratch:
 root=pathlib.Path(scratch)
 for model,suffix,rule in cases:
  config=model+'Broken'+suffix
  r=subprocess.run(['java','-XX:ActiveProcessorCount=2','-cp',str(jar),'tlc2.TLC','-workers','1','-metadir',str(root/config),'-config',str(skill/(config+'.cfg')),str(skill/(model+'.tla'))],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
  print(config+':\n'+r.stdout,flush=True)
  if r.returncode!=12 or 'Invariant '+rule+' is violated' not in r.stdout:raise SystemExit('Broken model missed rule '+config)
 for fault in faults:
  name,relative,testfile,package,old,new,pattern,message=fault
  source=repo/relative;original=source.read_text()
  if original.count(old)!=1:raise SystemExit('Source anchor changed '+name)
  for broken in [False,True]:
   variant=name+('-broken' if broken else '-current')
   overlay={'Replace':{str(source.parent/'zz_formal_backup_controls_test.go'):str(skill/testfile)}}
   if broken:
    patched=root/(variant+'.go');patched.write_text(original.replace(old,new));overlay['Replace'][str(source)]=str(patched)
   path=root/(variant+'.json');path.write_text(json.dumps(overlay))
   r=subprocess.run(['go','test','-count=1','-overlay',str(path),package,'-run',pattern],cwd=repo,env=env,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
   print(variant+':\n'+r.stdout,flush=True)
   if not broken and r.returncode:raise SystemExit('Current source failed '+name)
   if broken and (r.returncode==0 or message not in r.stdout):raise SystemExit('Source fault missed assertion '+name)
print('Remaining backup property controls passed.')
