#!/usr/bin/env python3
import hashlib,json,os,pathlib,subprocess,tempfile
skill=pathlib.Path(__file__).resolve().parent;repo=skill.parents[2]
jar=pathlib.Path(os.environ.get('TLA2TOOLS',pathlib.Path.home()/'.cache/database-formal/tla2tools-1.7.4.jar'))
if not jar.is_file() or hashlib.sha256(jar.read_bytes()).hexdigest()!='936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88':raise SystemExit('Use the pinned TLC 1.7.4 jar.')
env=dict(os.environ,GOMAXPROCS='2',GOFLAGS='-p=2')
with tempfile.TemporaryDirectory(prefix='database-install-formal-') as scratch:
 root=pathlib.Path(scratch)
 for module,rule in [('Initialization','FailureRemovesOwnedCatalog'),('Upgrade','ResumeKeepsTarget')]:
  for suffix in ['', 'Broken'] + (['BrokenRelease','BrokenCrash','BrokenCatalog'] if module=='Initialization' else ['BrokenTarget','BrokenMarker']):
   rule = {'BrokenRelease':'SuccessHasBothFiles','BrokenCrash':'CrashRetainsClaim','BrokenCatalog':'MetadataNeedsCatalog','BrokenTarget':'CompletedTargetInstalled','BrokenMarker':'IncompleteHasMarker'}.get(suffix, 'FailureRemovesOwnedCatalog' if module=='Initialization' else 'ResumeKeepsTarget')
   name=module+suffix
   r=subprocess.run(['java','-XX:ActiveProcessorCount=2','-cp',str(jar),'tlc2.TLC','-workers','1','-metadir',str(root/name),'-config',str(skill/(name+'.cfg')),str(skill/(module+'.tla'))],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
   print(r.stdout,flush=True)
   if not suffix and r.returncode:raise SystemExit('Current model failed: '+module)
   if suffix and (r.returncode!=12 or ('Invariant '+rule+' is violated') not in r.stdout):raise SystemExit('Broken model missed rule: '+module)
 cases=[('initialization','internal/instance/instance.go','./internal/instance','initialization_test.go.txt','TestFormalInitialization',[('release','if err := os.Remove(claim.staging); err != nil {','if err := error(nil); err != nil {','successful initialization retained claim'),('crash','func (paths initializationPaths) writeStaged(metadata []byte) error {','func (paths initializationPaths) writeStaged(metadata []byte) error { defer os.RemoveAll(paths.staging)','interrupted initialization lost claim'),('catalog','catalogInstalled, err := installStaged(paths.catalogTemporary(), paths.catalog())','catalogInstalled, err := false, error(nil)','metadata installed without catalog'),('cleanup','if catalog {','if false {','failed initialization retained owned catalog')]),('upgrade','cmd/database/upgrade.go','./cmd/database','upgrade_test.go.txt','TestFormalUpgrade',[('marker','if err := writeUpgradeMarker(request.directory, *marker); err != nil {','if err := error(nil); err != nil {','incomplete upgrade has no marker'),('resume','if marker != nil && (marker.TargetVersion != request.target || marker.SourceInstanceID != metadata.InstanceID) {','if false {','mismatched resume was accepted'),('target','metadata.DataVersion = request.target','metadata.DataVersion = "0.1.0"','completed upgrade did not install target')])]
 for label,relative,package,testfile,testname,mutations in cases:
  source=repo/relative;text=source.read_text()
  for mutation in [None]+mutations:
   name=label+('-current' if mutation is None else '-'+mutation[0])
   overlay={'Replace':{str(source.parent/'zz_formal_install_test.go'):str(skill/testfile)}}
   if mutation:
    _,old,new,message=mutation
    if text.count(old)!=1:raise SystemExit('Source changed: inspect '+name)
    patched=root/(name+'.go');patched.write_text(text.replace(old,new));overlay['Replace'][str(source)]=str(patched)
   config=root/(name+'.json');config.write_text(json.dumps(overlay))
   r=subprocess.run(['go','test','-count=1','-overlay',str(config),package,'-run','^'+testname],cwd=repo,env=env,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
   print(name+':\n'+r.stdout,flush=True)
   if mutation is None and r.returncode:raise SystemExit('Current source probe failed: '+label)
   if mutation and (r.returncode==0 or message not in r.stdout):raise SystemExit('Broken source missed assertion: '+name)
 print('Initialization and upgrade models and source probes passed; seven broken models and seven source mutations were caught.')
