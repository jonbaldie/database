#!/usr/bin/env python3
import hashlib, json, os, pathlib, subprocess, tempfile
skill=pathlib.Path(__file__).resolve().parent
repo=skill.parents[2]
jar=pathlib.Path(os.environ.get('TLA2TOOLS',pathlib.Path.home()/'.cache/database-formal/tla2tools-1.7.4.jar'))
if not jar.is_file() or hashlib.sha256(jar.read_bytes()).hexdigest()!='936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88':raise SystemExit('Use pinned TLC 1.7.4 from verify-wal-atomicity.')
env=dict(os.environ,GOMAXPROCS='2',GOFLAGS='-p=2')
with tempfile.TemporaryDirectory(prefix='database-shutdown-latch-') as scratch:
 root=pathlib.Path(scratch)
 for suffix in ['', 'Broken']:
  name='ShutdownLatch'+suffix
  result=subprocess.run(['java','-XX:ActiveProcessorCount=2','-cp',str(jar),'tlc2.TLC','-workers','1','-metadir',str(root/name),'-config',str(skill/(name+'.cfg')),str(skill/'ShutdownLatch.tla')],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
  print(result.stdout,flush=True)
  if not suffix and result.returncode:raise SystemExit('Shutdown latch model failed')
  if suffix and (result.returncode!=12 or 'Invariant FirstRequestStaysLatched is violated' not in result.stdout):raise SystemExit('Broken latch model missed its rule')
 source=repo/'internal/mysql/shutdown.go'
 original=source.read_text()
 old='func (s *Server) RequestShutdown(operationID string) {'
 new=old+'\n\ts.shutdownOperationID = operationID'
 for name in ['current','broken']:
  overlay={'Replace':{str(repo/'internal/mysql/zz_formal_shutdown_latch_test.go'):str(skill/'latch_test.go.txt')}}
  if name=='broken':
   if original.count(old)!=1:raise SystemExit('Source changed; inspect shutdown latch')
   path=root/'broken.go';path.write_text(original.replace(old,new));overlay['Replace'][str(source)]=str(path)
  config=root/(name+'.json');config.write_text(json.dumps(overlay))
  result=subprocess.run(['go','test','-count=1','-overlay',str(config),'./internal/mysql','-run','^TestFormalShutdownLatch$'],cwd=repo,env=env,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
  print(name+':\n'+result.stdout,flush=True)
  if name=='current' and result.returncode:raise SystemExit('Current shutdown latch failed')
  if name=='broken' and (result.returncode==0 or 'second shutdown replaced first operation' not in result.stdout):raise SystemExit('Broken shutdown latch missed assertion')
print('Shutdown latch model, source, and negative controls passed.')
