title: "Session limit selected"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Breaks Ceiling
    lg1: Path to the Ceiling bug
  }
  class lg0 breaks
  class lg1 bugPath
  s0: Session limit selected
  s1: Session limit assignment checked
  s2: Session ceiling exceeded
